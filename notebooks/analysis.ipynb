import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
warnings.filterwarnings('ignore')

# Load dataset
df = pd.read_csv('../data/ethereum.csv', parse_dates=['date'])
print(f'Dataset shape: {df.shape}')
df.head()
  print('=== Data Types ===')
print(df.dtypes)
print('\n=== Missing Values ===')
print(df.isnull().sum())
print('\n=== Basic Statistics ===')
df.describe()
  # Check for duplicates
print(f'Duplicate rows: {df.duplicated().sum()}')
df = df.drop_duplicates(subset='date')
df = df.sort_values('date').reset_index(drop=True)

# Fill rolling MA NaN (first few rows)
df['ma_7']  = df['ma_7'].fillna(df['price'])
df['ma_30'] = df['ma_30'].fillna(df['price'])
df['ma_90'] = df['ma_90'].fillna(df['price'])

print(f'Cleaned dataset: {df.shape[0]} rows, {df.shape[1]} columns')
print(f'Date range: {df.date.min().date()} to {df.date.max().date()}')
  fig, ax = plt.subplots(figsize=(14, 5))
ax.plot(df['date'], df['price'], color='#627eea', linewidth=1)
ax.plot(df['date'], df['ma_30'], color='#f6c90e', linewidth=1.2, linestyle='--', label='MA-30')
ax.plot(df['date'], df['ma_90'], color='#e74c3c', linewidth=1.2, linestyle='--', label='MA-90')
ax.set_title('Ethereum Price Over Time', fontsize=14, fontweight='bold')
ax.set_xlabel('Date')
ax.set_ylabel('Price (USD)')
ax.legend()
plt.tight_layout()
plt.show()
  fig, ax = plt.subplots(figsize=(10, 5))
data = df['price_change_pct'].dropna()
ax.hist(data, bins=80, color='#627eea', edgecolor='none', alpha=0.8)
ax.axvline(data.mean(), color='#f6c90e', linewidth=1.5, label=f'Mean: {data.mean():.2f}%')
ax.axvline(data.median(), color='#2ecc71', linewidth=1.5, label=f'Median: {data.median():.2f}%')
ax.set_title('Daily Return Distribution', fontsize=14, fontweight='bold')
ax.set_xlabel('Daily Return (%)')
ax.set_ylabel('Frequency')
ax.legend()
plt.tight_layout()
plt.show()
print(f'Skewness : {data.skew():.3f}')
print(f'Kurtosis : {data.kurtosis():.3f}')
    avg = df.groupby('year')['price'].mean()
fig, ax = plt.subplots(figsize=(10, 5))
avg.plot(kind='bar', ax=ax, color='#627eea', edgecolor='none')
ax.set_title('Average ETH Price by Year', fontsize=14, fontweight='bold')
ax.set_xlabel('Year')
ax.set_ylabel('Average Price (USD)')
ax.set_xticklabels(avg.index, rotation=45)
plt.tight_layout()
plt.show()
  cols = ['price','market_cap_b','volume_b','price_change_pct','ma_7','ma_30','volatility_30d']
corr = df[cols].dropna().corr()
fig, ax = plt.subplots(figsize=(9, 7))
sns.heatmap(corr, annot=True, fmt='.2f', cmap='coolwarm', ax=ax, linewidths=0.5)
ax.set_title('Feature Correlation Matrix', fontsize=14, fontweight='bold')
plt.tight_layout()
plt.show()
  fig, ax = plt.subplots(figsize=(12, 5))
df.boxplot(column='price', by='year', ax=ax, patch_artist=True)
ax.set_title('Price Distribution by Year')
plt.suptitle('')
ax.set_xlabel('Year')
ax.set_ylabel('Price (USD)')
plt.tight_layout()
plt.show()
    sample = df.sample(1500, random_state=42)
fig, ax = plt.subplots(figsize=(9, 5))
sc = ax.scatter(sample['volume_b'], sample['price'], c=sample['year'], cmap='plasma', alpha=0.5, s=15)
plt.colorbar(sc, ax=ax, label='Year')
ax.set_title('Volume vs Price (colored by Year)', fontsize=14, fontweight='bold')
ax.set_xlabel('Volume (Billion USD)')
ax.set_ylabel('Price (USD)')
plt.tight_layout()
plt.show()
  print('=== KEY FINDINGS ===')
print(f"All-Time High    : ${df['price'].max():>10,.2f}  on {df.loc[df['price'].idxmax(),'date'].date()}")
print(f"All-Time Low     : ${df['price'].min():>10,.4f}  on {df.loc[df['price'].idxmin(),'date'].date()}")
print(f"Best Day Return  : +{df['price_change_pct'].max():>7.2f}%  on {df.loc[df['price_change_pct'].idxmax(),'date'].date()}")
print(f"Worst Day Return :  {df['price_change_pct'].min():>7.2f}%  on {df.loc[df['price_change_pct'].idxmin(),'date'].date()}")
print(f"Avg Daily Volume :  ${df['volume_b'].mean():>8.2f}B")
print(f"Max Market Cap   :  ${df['market_cap_b'].max():>8.2f}B")
